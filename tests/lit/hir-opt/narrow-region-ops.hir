    // CHECK: hir.store_local %[[A16]] <{ local = #builtin.local_variable<0, u32> }>
    // CHECK-NEXT: scf.condition %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}} : (i1, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32);
