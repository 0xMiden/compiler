    // CHECK-NEXT: scf.yield %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}}, %{{\d+}} : (u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32);
    // CHECK: } : (u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32);
