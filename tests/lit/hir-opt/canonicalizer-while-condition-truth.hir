// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{enable-patterns=while-condition-truth}))' | filecheck %s
// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{enable-patterns=while-condition-truth}))' | hir-opt --verify - | filecheck %s

// Coverage for the `while-condition-truth` canonicalization of `scf.while`. The canonicalizer is
// restricted to that single pattern so that no other pattern touches the loops below (the greedy
// driver still folds, erases trivially dead operations and simplifies regions). The second RUN
// line re-parses and verifies the rewritten IR, so every printed form must be valid input.
//
// The after body only runs when the condition held, so when `scf.condition` forwards its own
// condition value to an after-block argument, the uses of that argument are replaced with the
// constant `true`. The loop itself keeps its operands, block arguments and results.
builtin.module private @while_condition_truth {
    // The condition is forwarded once and the after-block argument is used by the select: the use
    // becomes a `true` constant.
    // CHECK: @forwarded_once(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[T:\d+]] = arith.constant 1 : i1;
    // CHECK-NEXT: %{{\d+}}, %[[R:\d+]] = scf.while %[[A]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[CND]], %[[X]] : (i1, i1, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%{{\d+}}: i1, %[[P:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = cf.select %[[T]], %[[TEN]], %[[P]];
    // CHECK-NEXT: scf.yield %[[S]] : (u32);
    // CHECK-NEXT: } : (u32) -> (i1, u32);
    // CHECK-NEXT: builtin.ret %[[R]] : (u32);
    builtin.function public extern("C") @forwarded_once(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0 before {
        ^block1(%5: u32):
            %6 = arith.lt %5, %2;
            scf.condition %6, %6, %5 : (i1, i1, u32);
        } after {
        ^block2(%7: i1, %8: u32):
            %9 = cf.select %7, %2, %8;
            scf.yield %9 : (u32);
        } : (u32) -> (i1, u32);
        builtin.ret %4 : (u32);
    };

    // The condition is forwarded to after-block arguments 0 and 2, both used: both uses become
    // the same, single `true` constant.
    // CHECK: @forwarded_twice(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[T:\d+]] = arith.constant 1 : i1;
    // CHECK-NEXT: %{{\d+}}, %[[R:\d+]], %{{\d+}} = scf.while %[[A]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[CND]], %[[X]], %[[CND]] : (i1, i1, u32, i1);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%{{\d+}}: i1, %[[P:\d+]]: u32, %{{\d+}}: i1):
    // CHECK-NEXT: %[[S0:\d+]] = cf.select %[[T]], %[[TEN]], %[[P]];
    // CHECK-NEXT: %[[S1:\d+]] = cf.select %[[T]], %[[S0]], %[[B]];
    // CHECK-NEXT: scf.yield %[[S1]] : (u32);
    // CHECK-NEXT: } : (u32) -> (i1, u32, i1);
    // CHECK-NEXT: builtin.ret %[[R]] : (u32);
    builtin.function public extern("C") @forwarded_twice(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4, %5 = scf.while %0 before {
        ^block1(%6: u32):
            %7 = arith.lt %6, %2;
            scf.condition %7, %7, %6, %7 : (i1, i1, u32, i1);
        } after {
        ^block2(%8: i1, %9: u32, %10: i1):
            %11 = cf.select %8, %2, %9;
            %12 = cf.select %10, %11, %1;
            scf.yield %12 : (u32);
        } : (u32) -> (i1, u32, i1);
        builtin.ret %4 : (u32);
    };

    // Negative: the condition is forwarded, but the after-block argument has no uses, so nothing
    // is replaced and no constant is created.
    // CHECK: @unused_forwarded_arg(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %{{\d+}}, %[[R:\d+]] = scf.while %[[A]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[CND]], %[[X]] : (i1, i1, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%{{\d+}}: i1, %[[P:\d+]]: u32):
    // CHECK-NEXT: %[[N:\d+]] = arith.incr %[[P]];
    // CHECK-NEXT: scf.yield %[[N]] : (u32);
    // CHECK-NEXT: } : (u32) -> (i1, u32);
    // CHECK-NEXT: builtin.ret %[[R]] : (u32);
    builtin.function public extern("C") @unused_forwarded_arg(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0 before {
        ^block1(%5: u32):
            %6 = arith.lt %5, %2;
            scf.condition %6, %6, %5 : (i1, i1, u32);
        } after {
        ^block2(%7: i1, %8: u32):
            %9 = arith.incr %8;
            scf.yield %9 : (u32);
        } : (u32) -> (i1, u32);
        builtin.ret %4 : (u32);
    };

    // Negative: the condition is forwarded, but the after-block argument is only described by a
    // `di.debug_value`, which is not a real use, so nothing is replaced and no constant is
    // created. The `di.debug_value` still becomes a `di.debug_kill`: the greedy driver's region
    // simplification does not count it as a use of the argument either and erases it.
    // CHECK: @debug_only_forwarded_arg(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %{{\d+}}, %[[R:\d+]] = scf.while %[[A]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[CND]], %[[X]] : (i1, i1, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%{{\d+}}: i1, %[[P:\d+]]: u32):
    // CHECK-NEXT: di.debug_kill <{ variable = #di.variable<{ name = "c", file = "test.rs", line = 3 }> }>;
    // CHECK-NEXT: %[[N:\d+]] = arith.incr %[[P]];
    // CHECK-NEXT: scf.yield %[[N]] : (u32);
    // CHECK-NEXT: } : (u32) -> (i1, u32);
    // CHECK-NEXT: builtin.ret %[[R]] : (u32);
    builtin.function public extern("C") @debug_only_forwarded_arg(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0 before {
        ^block1(%5: u32):
            %6 = arith.lt %5, %2;
            scf.condition %6, %6, %5 : (i1, i1, u32);
        } after {
        ^block2(%7: i1, %8: u32):
            di.debug_value %7 <{ variable = #di.variable<{ name = "c", file = "test.rs", line = 3 }>, expression = #di.expression<[]> }> : (i1);
            %9 = arith.incr %8;
            scf.yield %9 : (u32);
        } : (u32) -> (i1, u32);
        builtin.ret %4 : (u32);
    };

    // Negative: the forwarded i1 value is not the condition, so its after-block argument keeps
    // its use.
    // CHECK: @other_value_forwarded(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %{{\d+}}, %[[R:\d+]] = scf.while %[[A]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: %[[OTHER:\d+]] = arith.lt %[[X]], %[[B]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[OTHER]], %[[X]] : (i1, i1, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[F:\d+]]: i1, %[[P:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = cf.select %[[F]], %[[TEN]], %[[P]];
    // CHECK-NEXT: scf.yield %[[S]] : (u32);
    // CHECK-NEXT: } : (u32) -> (i1, u32);
    // CHECK-NEXT: builtin.ret %[[R]] : (u32);
    builtin.function public extern("C") @other_value_forwarded(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0 before {
        ^block1(%5: u32):
            %6 = arith.lt %5, %2;
            %7 = arith.lt %5, %1;
            scf.condition %6, %7, %5 : (i1, i1, u32);
        } after {
        ^block2(%8: i1, %9: u32):
            %10 = cf.select %8, %2, %9;
            scf.yield %10 : (u32);
        } : (u32) -> (i1, u32);
        builtin.ret %4 : (u32);
    };
};
