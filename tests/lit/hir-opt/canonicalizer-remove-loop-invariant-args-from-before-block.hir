// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{enable-patterns=remove-loop-invariant-args-from-before-block}))' | filecheck %s

// Coverage for the `remove-loop-invariant-args-from-before-block` canonicalization of `scf.while`
// (#1419). The canonicalizer is restricted to that single pattern so that every rewrite (and
// every unchanged loop) below is attributable to it.
//
// A before-block argument is loop invariant when the value fed back to it over the back edge is
// always its initial value, i.e. when the i-th `scf.yield` operand
//   1. is the i-th `scf.while` operand itself, or
//   2. is the k-th after-block argument and the k-th `scf.condition` forwarded operand is either
//      the i-th before-block argument or the i-th `scf.while` operand.
// Such a column is dropped from the loop (`scf.while` operand, before-block argument, `scf.yield`
// operand) and the uses of the before-block argument are replaced with the initial value. The
// results of the loop, the after block and the `scf.condition` operands are left as they are.
builtin.module private @remove_loop_invariant_args {
    // Case 1: the yield operand for column 0 is the loop operand `%0` itself.
    // CHECK: @yield_init(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[Y]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[C]], %[[A]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[Q]], %[[P]]
    // CHECK-NEXT: scf.yield %[[S]] : (u32);
    // CHECK-NEXT: } : (u32) -> (u32, u32);
    // CHECK-NEXT: arith.add %[[R0]], %[[R1]]
    builtin.function public extern("C") @yield_init(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.lt %6, %2;
            scf.condition %7, %5, %6 : (i1, u32, u32);
        } after {
        ^block2(%8: u32, %9: u32):
            %10 = arith.add %9, %8 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %0, %10 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %11 = arith.add %3, %4 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %11 : (u32);
    };

    // Case 2: the yield operand for column 0 is after-block argument 0, and `scf.condition`
    // forwards before-block argument 0 in position 0, so the column is passed around unchanged.
    // CHECK: @yield_forwarded_before_arg(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[Y]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[C]], %[[A]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[Q]], %[[P]]
    // CHECK-NEXT: scf.yield %[[S]] : (u32);
    // CHECK-NEXT: } : (u32) -> (u32, u32);
    // CHECK-NEXT: arith.add %[[R0]], %[[R1]]
    builtin.function public extern("C") @yield_forwarded_before_arg(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.lt %6, %2;
            scf.condition %7, %5, %6 : (i1, u32, u32);
        } after {
        ^block2(%8: u32, %9: u32):
            %10 = arith.add %9, %8 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %8, %10 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %11 = arith.add %3, %4 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %11 : (u32);
    };

    // Case 2, second form: `scf.condition` forwards the loop operand `%0` itself (not the
    // before-block argument) in position 0, and the yield feeds after-block argument 0 back.
    // The before-block argument is used in the before body; that use becomes `%0`.
    // CHECK: @yield_forwarded_init(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[ONE:\d+]] = arith.constant 1 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[A]], %[[Y]]
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[S]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[C]], %[[A]], %[[S]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%{{\d+}}: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[N:\d+]] = arith.add %[[Q]], %[[ONE]]
    // CHECK-NEXT: scf.yield %[[N]] : (u32);
    // CHECK-NEXT: } : (u32) -> (u32, u32);
    // CHECK-NEXT: arith.add %[[R0]], %[[R1]]
    builtin.function public extern("C") @yield_forwarded_init(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3 = arith.constant 1 : u32;
        %4, %5 = scf.while %0, %1 before {
        ^block1(%6: u32, %7: u32):
            %8 = arith.add %6, %7 <{ overflow = #builtin.overflow<unchecked> }>;
            %9 = arith.lt %8, %2;
            scf.condition %9, %0, %8 : (i1, u32, u32);
        } after {
        ^block2(%10: u32, %11: u32):
            %12 = arith.add %11, %3 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %10, %12 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %13 = arith.add %4, %5 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %13 : (u32);
    };

    // Columns 0 (case 1) and 2 (case 2) are invariant, columns 1 and 3 are not: the loop keeps
    // operands `%1, %3`, the surviving before-block arguments keep their relative order, and all
    // four results stay in place.
    // CHECK: @mixed_positions(%[[A:\d+]]: u32, %[[B:\d+]]: u32, %[[C:\d+]]: u32, %[[D:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]], %[[R2:\d+]], %[[R3:\d+]] = scf.while %[[B]], %[[D]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[S0:\d+]] = arith.add %[[A]], %[[C]]
    // CHECK-NEXT: %[[S1:\d+]] = arith.add %[[S0]], %[[X]]
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[S1]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[A]], %[[X]], %[[C]], %[[Y]] : (i1, u32, u32, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P0:\d+]]: u32, %[[P1:\d+]]: u32, %[[P2:\d+]]: u32, %[[P3:\d+]]: u32):
    // CHECK-NEXT: %[[N1:\d+]] = arith.add %[[P1]], %[[P0]]
    // CHECK-NEXT: %[[N3:\d+]] = arith.add %[[P3]], %[[P2]]
    // CHECK-NEXT: scf.yield %[[N1]], %[[N3]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> (u32, u32, u32, u32);
    // CHECK-NEXT: %[[T0:\d+]] = arith.add %[[R0]], %[[R1]]
    // CHECK-NEXT: %[[T1:\d+]] = arith.add %[[T0]], %[[R2]]
    // CHECK-NEXT: arith.add %[[T1]], %[[R3]]
    builtin.function public extern("C") @mixed_positions(%0: u32, %1: u32, %2: u32, %3: u32) -> u32 {
        %4 = arith.constant 10 : u32;
        %5, %6, %7, %8 = scf.while %0, %1, %2, %3 before {
        ^block1(%9: u32, %10: u32, %11: u32, %12: u32):
            %13 = arith.add %9, %11 <{ overflow = #builtin.overflow<unchecked> }>;
            %14 = arith.add %13, %10 <{ overflow = #builtin.overflow<unchecked> }>;
            %15 = arith.lt %14, %4;
            scf.condition %15, %9, %10, %11, %12 : (i1, u32, u32, u32, u32);
        } after {
        ^block2(%16: u32, %17: u32, %18: u32, %19: u32):
            %20 = arith.add %17, %16 <{ overflow = #builtin.overflow<unchecked> }>;
            %21 = arith.add %19, %18 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %0, %20, %18, %21 : (u32, u32, u32, u32);
        } : (u32, u32, u32, u32) -> (u32, u32, u32, u32);
        %22 = arith.add %5, %6 <{ overflow = #builtin.overflow<unchecked> }>;
        %23 = arith.add %22, %7 <{ overflow = #builtin.overflow<unchecked> }>;
        %24 = arith.add %23, %8 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %24 : (u32);
    };

    // Every column is invariant (column 0 by case 2, column 1 by case 1): the loop is left with
    // no operands, an argument-less before block and an empty yield, while its results survive.
    // CHECK: @all_invariant(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while before {
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[A]], %[[B]]
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[S]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[C]], %[[A]], %[[S]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%{{\d+}}: u32, %{{\d+}}: u32):
    // CHECK-NEXT: scf.yield : ();
    // CHECK-NEXT: } : () -> (u32, u32);
    // CHECK-NEXT: arith.add %[[R0]], %[[R1]]
    builtin.function public extern("C") @all_invariant(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.add %5, %6 <{ overflow = #builtin.overflow<unchecked> }>;
            %8 = arith.lt %7, %2;
            scf.condition %8, %5, %7 : (i1, u32, u32);
        } after {
        ^block2(%9: u32, %10: u32):
            scf.yield %9, %1 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %11 = arith.add %3, %4 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %11 : (u32);
    };

    // The invariant before-block argument is used inside a nested region of the before body;
    // those uses are replaced too.
    // CHECK: @nested_use(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[ONE:\d+]] = arith.constant 1 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[Y]], %[[TEN]];
    // CHECK-NEXT: %[[V:\d+]] = scf.if %[[C]] then {
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[A]], %[[ONE]]
    // CHECK-NEXT: scf.yield %[[S]] : (u32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: scf.yield %[[A]] : (u32);
    // CHECK-NEXT: } : (i1) -> (u32);
    // CHECK-NEXT: scf.condition %[[C]], %[[V]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[N:\d+]] = arith.add %[[Q]], %[[P]]
    // CHECK-NEXT: scf.yield %[[N]] : (u32);
    // CHECK-NEXT: } : (u32) -> (u32, u32);
    // CHECK-NEXT: arith.add %[[R0]], %[[R1]]
    builtin.function public extern("C") @nested_use(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3 = arith.constant 1 : u32;
        %4, %5 = scf.while %0, %1 before {
        ^block1(%6: u32, %7: u32):
            %8 = arith.lt %7, %2;
            %9 = scf.if %8 then {
                %10 = arith.add %6, %3 <{ overflow = #builtin.overflow<unchecked> }>;
                scf.yield %10 : (u32);
            } else {
                scf.yield %6 : (u32);
            } : (i1) -> (u32);
            scf.condition %8, %9, %7 : (i1, u32, u32);
        } after {
        ^block2(%11: u32, %12: u32):
            %13 = arith.add %12, %11 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %0, %13 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %14 = arith.add %4, %5 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %14 : (u32);
    };

    // Negative: both yield operands are computed in the after body, nothing is invariant and
    // the loop is left untouched.
    // CHECK: @no_invariant(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[A]], %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[Y]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[C]], %[[X]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[Q]], %[[P]]
    // CHECK-NEXT: scf.yield %[[S]], %[[S]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> (u32, u32);
    builtin.function public extern("C") @no_invariant(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.lt %6, %2;
            scf.condition %7, %5, %6 : (i1, u32, u32);
        } after {
        ^block2(%8: u32, %9: u32):
            %10 = arith.add %9, %8 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %10, %10 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %11 = arith.add %3, %4 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %11 : (u32);
    };

    // Negative: the yield operand for column 0 is the function argument `%0`, a block argument
    // of the entry block with index 0. Only after-block arguments are mirrored by the
    // `scf.condition` operands, so the fact that operand 0 of the condition is the before-block
    // argument must not make column 0 invariant (its value is `0` on the first trip and `%0`
    // afterwards).
    // CHECK: @foreign_block_arg(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[ZERO:\d+]] = arith.constant 0 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[ZERO]], %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[Y]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[C]], %[[X]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[Q]], %[[P]]
    // CHECK-NEXT: scf.yield %[[A]], %[[S]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> (u32, u32);
    builtin.function public extern("C") @foreign_block_arg(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3 = arith.constant 0 : u32;
        %4, %5 = scf.while %3, %1 before {
        ^block1(%6: u32, %7: u32):
            %8 = arith.lt %7, %2;
            scf.condition %8, %6, %7 : (i1, u32, u32);
        } after {
        ^block2(%9: u32, %10: u32):
            %11 = arith.add %10, %9 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %0, %11 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %12 = arith.add %4, %5 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %12 : (u32);
    };

    // Negative: the yield operand for column 0 is after-block argument 0, but the condition
    // forwards a value computed from the before-block argument, so the column changes every
    // trip.
    // CHECK: @forwarded_other_value(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[ONE:\d+]] = arith.constant 1 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[A]], %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[X]], %[[ONE]]
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[Y]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[C]], %[[S]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[N:\d+]] = arith.add %[[Q]], %[[P]]
    // CHECK-NEXT: scf.yield %[[P]], %[[N]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> (u32, u32);
    builtin.function public extern("C") @forwarded_other_value(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3 = arith.constant 1 : u32;
        %4, %5 = scf.while %0, %1 before {
        ^block1(%6: u32, %7: u32):
            %8 = arith.add %6, %3 <{ overflow = #builtin.overflow<unchecked> }>;
            %9 = arith.lt %7, %2;
            scf.condition %9, %8, %7 : (i1, u32, u32);
        } after {
        ^block2(%10: u32, %11: u32):
            %12 = arith.add %11, %10 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %10, %12 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %13 = arith.add %4, %5 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %13 : (u32);
    };
};
