// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{enable-patterns=while-unused-result}))' | filecheck %s
// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{enable-patterns=while-unused-result}))' | hir-opt --verify - | filecheck %s

// Coverage for the `while-unused-result` canonicalization of `scf.while`. The canonicalizer is
// restricted to that single pattern so that no other pattern touches the loops below (the greedy
// driver still folds, erases trivially dead operations and simplifies regions). The second RUN
// line re-parses and verifies the rewritten IR, so every printed form must be valid input.
//
// A result is removed when neither the result nor the after-block argument at the same position
// has uses. The result, the after-block argument and the `scf.condition` operand forwarded to
// them go away; the iteration arguments (`scf.while` operands, before-block arguments and
// `scf.yield` operands) are untouched.
builtin.module private @while_unused_result {
    // Results 0, 2 and 4 (first, middle and last) and their after-block arguments are unused;
    // results 1 and 3 are used after the loop and their after-block arguments in the after body.
    // The condition keeps the operands forwarded at positions 1 and 3.
    // CHECK: @unused_positions(%[[A:\d+]]: u32, %[[B:\d+]]: u32, %[[C:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[A]], %[[B]], %[[C]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %[[Y:\d+]]: u32, %{{\d+}}: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[Y]], %[[X]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[P]], %[[Q]]
    // CHECK-NEXT: scf.yield %[[S]], %[[P]], %[[Q]] : (u32, u32, u32);
    // CHECK-NEXT: } : (u32, u32, u32) -> (u32, u32);
    // CHECK-NEXT: arith.add %[[R0]], %[[R1]]
    builtin.function public extern("C") @unused_positions(%0: u32, %1: u32, %2: u32) -> u32 {
        %3 = arith.constant 10 : u32;
        %4, %5, %6, %7, %8 = scf.while %0, %1, %2 before {
        ^block1(%9: u32, %10: u32, %11: u32):
            %12 = arith.lt %9, %3;
            scf.condition %12, %9, %10, %11, %9, %10 : (i1, u32, u32, u32, u32, u32);
        } after {
        ^block2(%13: u32, %14: u32, %15: u32, %16: u32, %17: u32):
            %18 = arith.add %14, %16 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %18, %14, %16 : (u32, u32, u32);
        } : (u32, u32, u32) -> (u32, u32, u32, u32, u32);
        %19 = arith.add %5, %7 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %19 : (u32);
    };

    // Negative: result 0 is unused, but after-block argument 0 is used in the after body, so the
    // result is kept and the loop is left untouched.
    // CHECK: @result_unused_arg_used(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %{{\d+}}, %[[R1:\d+]] = scf.while %[[A]], %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[X]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[P]], %[[Q]]
    // CHECK-NEXT: scf.yield %[[S]], %[[Q]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> (u32, u32);
    // CHECK-NEXT: builtin.ret %[[R1]] : (u32);
    builtin.function public extern("C") @result_unused_arg_used(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.lt %5, %2;
            scf.condition %7, %5, %6 : (i1, u32, u32);
        } after {
        ^block2(%8: u32, %9: u32):
            %10 = arith.add %8, %9 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %10, %9 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        builtin.ret %4 : (u32);
    };

    // Negative: after-block argument 0 is unused, but result 0 is used after the loop, so the
    // result is kept and the loop is left untouched.
    // CHECK: @result_used_arg_unused(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[A]], %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[X]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%{{\d+}}: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[Q]], %[[TEN]]
    // CHECK-NEXT: scf.yield %[[S]], %[[Q]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> (u32, u32);
    // CHECK-NEXT: arith.add %[[R0]], %[[R1]]
    builtin.function public extern("C") @result_used_arg_unused(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.lt %5, %2;
            scf.condition %7, %5, %6 : (i1, u32, u32);
        } after {
        ^block2(%8: u32, %9: u32):
            %10 = arith.add %9, %2 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %10, %9 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %11 = arith.add %3, %4 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %11 : (u32);
    };

    // Every result and every after-block argument is unused: the loop is left with no results, an
    // argument-less after block and a condition that forwards nothing, while its iteration
    // arguments survive.
    // CHECK: @all_unused(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: scf.while %[[A]], %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %{{\d+}}: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]] : (i1);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}:
    // CHECK-NEXT: %[[N:\d+]] = arith.incr %[[A]];
    // CHECK-NEXT: scf.yield %[[N]], %[[B]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> ();
    // CHECK-NEXT: builtin.ret %[[A]] : (u32);
    builtin.function public extern("C") @all_unused(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.lt %5, %2;
            scf.condition %7, %5, %6 : (i1, u32, u32);
        } after {
        ^block2(%8: u32, %9: u32):
            %10 = arith.incr %0;
            scf.yield %10, %1 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        builtin.ret %0 : (u32);
    };

    // Negative: every result is used after the loop and every after-block argument in the after
    // body, so the loop is left untouched.
    // CHECK: @none_unused(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.while %[[A]], %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %[[Y:\d+]]: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[Y]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[X]], %[[Y]] : (i1, u32, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32, %[[Q:\d+]]: u32):
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[Q]], %[[P]]
    // CHECK-NEXT: scf.yield %[[P]], %[[S]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> (u32, u32);
    // CHECK-NEXT: arith.add %[[R0]], %[[R1]]
    builtin.function public extern("C") @none_unused(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.lt %6, %2;
            scf.condition %7, %5, %6 : (i1, u32, u32);
        } after {
        ^block2(%8: u32, %9: u32):
            %10 = arith.add %9, %8 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %8, %10 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %11 = arith.add %3, %4 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %11 : (u32);
    };

    // Debug uses do not keep a column alive. Result 1 is only described by a `di.debug_value`
    // after the loop and after-block argument 2 only by one in the after body; both columns are
    // removed and each `di.debug_value` becomes a `di.debug_kill` of its variable in place.
    // CHECK: @debug_uses(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[TEN:\d+]] = arith.constant 10 : u32;
    // CHECK-NEXT: %[[R0:\d+]] = scf.while %[[A]], %[[B]] before {
    // CHECK-NEXT: ^block{{\d+}}(%[[X:\d+]]: u32, %{{\d+}}: u32):
    // CHECK-NEXT: %[[CND:\d+]] = arith.lt %[[X]], %[[TEN]];
    // CHECK-NEXT: scf.condition %[[CND]], %[[X]] : (i1, u32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^block{{\d+}}(%[[P:\d+]]: u32):
    // CHECK-NEXT: di.debug_kill <{ variable = #di.variable<{ name = "a", file = "test.rs", line = 3 }> }>;
    // CHECK-NEXT: %[[N:\d+]] = arith.incr %[[P]];
    // CHECK-NEXT: scf.yield %[[N]], %[[B]] : (u32, u32);
    // CHECK-NEXT: } : (u32, u32) -> (u32);
    // CHECK-NEXT: di.debug_kill <{ variable = #di.variable<{ name = "r", file = "test.rs", line = 5 }> }>;
    // CHECK-NEXT: builtin.ret %[[R0]] : (u32);
    builtin.function public extern("C") @debug_uses(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4, %5 = scf.while %0, %1 before {
        ^block1(%6: u32, %7: u32):
            %8 = arith.lt %6, %2;
            scf.condition %8, %6, %7, %6 : (i1, u32, u32, u32);
        } after {
        ^block2(%9: u32, %10: u32, %11: u32):
            di.debug_value %11 <{ variable = #di.variable<{ name = "a", file = "test.rs", line = 3 }>, expression = #di.expression<[]> }> : (u32);
            %12 = arith.incr %9;
            scf.yield %12, %1 : (u32, u32);
        } : (u32, u32) -> (u32, u32, u32);
        di.debug_value %4 <{ variable = #di.variable<{ name = "r", file = "test.rs", line = 5 }>, expression = #di.expression<[]> }> : (u32);
        builtin.ret %3 : (u32);
    };
};
