// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{enable-patterns=if-remove-unused-results}))' | filecheck %s
// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{enable-patterns=if-remove-unused-results}))' | hir-opt --verify - | filecheck %s

// Coverage for the `if-remove-unused-results` canonicalization of `scf.if`. The canonicalizer is
// restricted to that single pattern so that no other pattern touches the operations below (the
// greedy driver still folds, erases trivially dead operations and simplifies regions). The second
// RUN line re-parses and verifies the rewritten IR, so every printed form must be valid input.
//
// A result without uses is removed, together with the `scf.yield` operands that produce it in
// every branch.
builtin.module private @if_remove_unused_results {
    // Result 1 is unused: the `scf.if` keeps result 0 only.
    // CHECK: @unused_result(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[A]], %[[B]];
    // CHECK-NEXT: %[[R:\d+]] = scf.if %[[C]] then {
    // CHECK-NEXT: %[[N:\d+]] = arith.incr %[[A]];
    // CHECK-NEXT: scf.yield %[[N]] : (u32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: scf.yield %[[B]] : (u32);
    // CHECK-NEXT: } : (i1) -> (u32);
    // CHECK-NEXT: builtin.ret %[[R]] : (u32);
    builtin.function public extern("C") @unused_result(%0: u32, %1: u32) -> u32 {
        %2 = arith.lt %0, %1;
        %3, %4 = scf.if %2 then {
            %5 = arith.incr %0;
            scf.yield %5, %1 : (u32, u32);
        } else {
            scf.yield %1, %0 : (u32, u32);
        } : (i1) -> (u32, u32);
        builtin.ret %3 : (u32);
    };

    // Result 1 is only described by a `di.debug_value`, which does not keep it alive. Erasing the
    // replaced `scf.if` erases that `di.debug_value` with it; this used to panic with an
    // `AliasingViolationError` because the result was still borrowed while its debug user was
    // erased.
    // CHECK: @debug_only_use(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[A]], %[[B]];
    // CHECK-NEXT: %[[R:\d+]] = scf.if %[[C]] then {
    // CHECK-NEXT: %[[N:\d+]] = arith.incr %[[A]];
    // CHECK-NEXT: scf.yield %[[N]] : (u32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: scf.yield %[[B]] : (u32);
    // CHECK-NEXT: } : (i1) -> (u32);
    // CHECK-NEXT: builtin.ret %[[R]] : (u32);
    builtin.function public extern("C") @debug_only_use(%0: u32, %1: u32) -> u32 {
        %2 = arith.lt %0, %1;
        %3, %4 = scf.if %2 then {
            %5 = arith.incr %0;
            scf.yield %5, %1 : (u32, u32);
        } else {
            scf.yield %1, %0 : (u32, u32);
        } : (i1) -> (u32, u32);
        di.debug_value %4 <{ variable = #di.variable<{ name = "u", file = "test.rs", line = 4 }>, expression = #di.expression<[]> }> : (u32);
        builtin.ret %3 : (u32);
    };

    // Negative: both results are used, so the `scf.if` is left untouched.
    // CHECK: @all_used(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
    // CHECK-NEXT: %[[C:\d+]] = arith.lt %[[A]], %[[B]];
    // CHECK-NEXT: %[[R0:\d+]], %[[R1:\d+]] = scf.if %[[C]] then {
    // CHECK-NEXT: %[[N:\d+]] = arith.incr %[[A]];
    // CHECK-NEXT: scf.yield %[[N]], %[[B]] : (u32, u32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: scf.yield %[[B]], %[[A]] : (u32, u32);
    // CHECK-NEXT: } : (i1) -> (u32, u32);
    // CHECK-NEXT: %[[S:\d+]] = arith.add %[[R0]], %[[R1]]
    // CHECK-NEXT: builtin.ret %[[S]] : (u32);
    builtin.function public extern("C") @all_used(%0: u32, %1: u32) -> u32 {
        %2 = arith.lt %0, %1;
        %3, %4 = scf.if %2 then {
            %5 = arith.incr %0;
            scf.yield %5, %1 : (u32, u32);
        } else {
            scf.yield %1, %0 : (u32, u32);
        } : (i1) -> (u32, u32);
        %6 = arith.add %3, %4 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %6 : (u32);
    };
};
