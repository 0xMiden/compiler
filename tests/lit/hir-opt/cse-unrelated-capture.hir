// RUN: hir-opt %s --verify --pass-pipeline='builtin.module(builtin.function(cse))' | filecheck %s
// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(cse))' | filecheck %s
builtin.module public @unrelated {
// CHECK-LABEL: @unrelated
// CHECK: scf.if
// CHECK: di.debug_value {{.*}}name = "branch"
// CHECK: di.debug_kill {{.*}}name = "branch"
// CHECK: di.debug_value {{.*}}name = "other"
// CHECK-NOT: di.debug_kill
// CHECK-NOT: scf.if
// CHECK: builtin.ret
    builtin.function public extern("C") @unrelated(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        di.debug_value %right <{ variable = #di.variable<{ name = "other", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        builtin.ret %sum : (u32);
    };

// CHECK-LABEL: @nested_unrelated
// CHECK: scf.if
// CHECK: scf.if
// CHECK: di.debug_value {{.*}}name = "other"
// CHECK-NOT: di.debug_kill
// CHECK-NOT: scf.if
// CHECK: builtin.ret
    builtin.function public extern("C") @nested_unrelated(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %intervening = scf.if %condition then {
di.debug_value %right <{ variable = #di.variable<{ name = "other", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
scf.yield %right : (u32);
} else { scf.yield %left : (u32); } : (i1) -> u32;
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        %with_other = arith.add %sum, %intervening <{ overflow = #builtin.overflow<wrapping> }>;
builtin.ret %with_other : (u32);
    };


// CHECK-LABEL: @unknown
// CHECK: scf.if
// CHECK: hir.exec
// CHECK: di.debug_kill
// CHECK-NOT: scf.if
// CHECK: builtin.ret
    builtin.function public extern("C") @unknown(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %call = hir.exec @opaque(%right) : extern("C") (u32) -> u32;
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        builtin.ret %sum : (u32);
    };


// CHECK-LABEL: @nested_unknown
// CHECK: scf.if
// CHECK: scf.if
// CHECK: hir.exec
// CHECK: di.debug_kill
// CHECK-NOT: scf.if
// CHECK: builtin.ret
    builtin.function public extern("C") @nested_unknown(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %intervening = scf.if %condition then {
%call = hir.exec @opaque(%right) : extern("C") (u32) -> u32;
scf.yield %right : (u32);
} else { scf.yield %left : (u32); } : (i1) -> u32;
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        %with_other = arith.add %sum, %intervening <{ overflow = #builtin.overflow<wrapping> }>;
builtin.ret %with_other : (u32);
    };


// CHECK-LABEL: @nested_shadow
// CHECK: scf.if
// CHECK: scf.if
// CHECK: di.debug_value {{.*}}name = "branch"
// CHECK: di.debug_kill
// CHECK-NOT: scf.if
// CHECK: builtin.ret
    builtin.function public extern("C") @nested_shadow(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %intervening = scf.if %condition then {
di.debug_value %right <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 2 }>, expression = #di.expression<[]> }> : (u32);
scf.yield %right : (u32);
} else { scf.yield %left : (u32); } : (i1) -> u32;
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        %with_other = arith.add %sum, %intervening <{ overflow = #builtin.overflow<wrapping> }>;
builtin.ret %with_other : (u32);
    };


builtin.function private extern("C") @opaque(%arg: u32) -> u32 {};
};
