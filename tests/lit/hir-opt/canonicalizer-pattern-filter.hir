// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{disable-patterns=remove-loop-invariant-args-from-before-block}))' | filecheck %s
// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{enable-patterns="remove-loop-invariant-args-from-before-block;while-unused-result"}))' | filecheck %s --check-prefix=ENABLE
// RUN: not hir-opt %s --pass-pipeline='builtin.module(builtin.function(canonicalizer{bogus=1}))' 2>&1 | filecheck %s --check-prefix=ERR

// Coverage for the `enable-patterns` and `disable-patterns` options of the canonicalizer.
//
// Column 0 of the loop is invariant (the yield feeds the loop operand `%0` back), so the
// `remove-loop-invariant-args-from-before-block` pattern drops it whenever it runs.
//
// With the pattern disabled the rest of the canonicalizer runs, but the loop keeps both operands.
// CHECK: @yield_init(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
// CHECK: scf.while %[[A]], %[[B]] before {
// CHECK-NEXT: ^block{{\d+}}(%{{\d+}}: u32, %{{\d+}}: u32):
//
// With the pattern enabled (in a `;`-separated list) the invariant operand is removed.
// ENABLE: @yield_init(%[[A:\d+]]: u32, %[[B:\d+]]: u32)
// ENABLE: scf.while %[[B]] before {
// ENABLE-NEXT: ^block{{\d+}}(%{{\d+}}: u32):
//
// An unknown option is rejected.
// ERR: invalid option 'bogus' for pass 'canonicalizer'
builtin.module private @pattern_filter {
    builtin.function public extern("C") @yield_init(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 10 : u32;
        %3, %4 = scf.while %0, %1 before {
        ^block1(%5: u32, %6: u32):
            %7 = arith.lt %6, %2;
            scf.condition %7, %5, %6 : (i1, u32, u32);
        } after {
        ^block2(%8: u32, %9: u32):
            %10 = arith.add %9, %8 <{ overflow = #builtin.overflow<unchecked> }>;
            scf.yield %0, %10 : (u32, u32);
        } : (u32, u32) -> (u32, u32);
        %11 = arith.add %3, %4 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %11 : (u32);
    };
};
