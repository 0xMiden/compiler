// UNHANDLED: pass 'test-debug-info-mutation': unhandled debug-info
// DEPENDENCY: unhandled debug-info dependency mutation
// CONTRACT: debug-info {{.*}} contract
// CONTRACT: variable 'x'
// INSERT: unhandled debug-info insertion
// INSERT: variable 'x'

builtin.module public @debug_mutation_contract {
    // EQUIVALENT: @entrypoint(%[[FIRST:\d+]]: u32, %[[SECOND:\d+]]: u32)
    // EQUIVALENT: di.debug_value %[[SECOND]] {{.*}}name = "x"
    // EQUIVALENT-NEXT: di.debug_kill {{.*}}name = "x"
    // EQUIVALENT-NEXT: builtin.ret %[[FIRST]]
    // CLONE: @entrypoint(%[[ORIGINAL:\d+]]: u32, %[[OTHER:\d+]]: u32)
    // CLONE-NEXT: %[[VALUE:\d+]] = arith.bxor %[[ORIGINAL]], %[[OTHER]]
    // CLONE-NEXT: di.debug_value %[[VALUE]] {{.*}}name = "x"
    // CLONE-NEXT: di.debug_kill {{.*}}name = "x"
    // CLONE-NEXT: builtin.ret %[[ORIGINAL]]
    // INVALIDATE-LABEL: @entrypoint(
    // INVALIDATE-NEXT: di.debug_kill {{.*}}name = "x"
    // INVALIDATE-NEXT: di.debug_kill {{.*}}name = "x"
    // INVALIDATE-NEXT: builtin.ret
    builtin.function public extern("C") @entrypoint(%0: u32, %1: u32) -> u32 {
        %2 = arith.bxor %0, %1;
        di.debug_value %2 <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
        di.debug_kill <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 1 }> }>;
        builtin.ret %0 : (u32);
    };
};
