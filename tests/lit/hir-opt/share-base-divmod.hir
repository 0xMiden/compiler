// RUN: hir-opt %s --verify --pass-pipeline='builtin.module(builtin.function(share-base-divmod,canonicalizer))' | filecheck %s

// Divisions of one base plus constant offsets in a block share one division of the base. An offset
// is applied without a check only when its addition is proven not to overflow, or when one check of
// the base plus the largest unproven offset, at the first division, has passed.
builtin.module private @share_base_divmod {
    // Offsets 0, 8 and 4 share the division of the base; one check covers the largest offset and
    // runs before the first access, and the repeated alignment checks are removed.
    // CHECK: @unproven_offsets(%[[B:\d+]]: u32)
    // CHECK: %[[K:\d+]] = arith.constant 8 : u32;
    // CHECK-NEXT: %[[OVF:\d+]], %{{\d+}} = arith.add_overflowing %[[B]], %[[K]];
    // CHECK-NEXT: hir.assertz %[[OVF]] <{ code = #builtin.u32<0>
    // CHECK-NEXT: %[[R:\d+]], %[[Q:\d+]] = arith.divmod %[[B]], %{{\d+}};
    // CHECK-NEXT: hir.assertz %[[R]] <{ code = #builtin.u32<250>
    // CHECK-NEXT: %[[P0:\d+]] = hir.int_to_ptr %[[Q]]
    // CHECK-NEXT: hir.load %[[P0]];
    // CHECK-NEXT: %[[Q8:\d+]] = arith.add %[[Q]], %{{\d+}} <{ overflow = #builtin.overflow<unchecked> }>;
    // CHECK-NEXT: %[[P8:\d+]] = hir.int_to_ptr %[[Q8]]
    // CHECK-NEXT: hir.load %[[P8]];
    // CHECK-NEXT: %[[Q4:\d+]] = arith.add %[[Q]], %{{\d+}} <{ overflow = #builtin.overflow<unchecked> }>;
    // CHECK-NEXT: %[[P4:\d+]] = hir.int_to_ptr %[[Q4]]
    // CHECK-NEXT: hir.load %[[P4]];
    // CHECK-NEXT: builtin.ret
    builtin.function public extern("C") @unproven_offsets(%0: u32) -> (i32, i32, i32) {
        %1 = arith.constant 4 : u32;
        %2, %3 = arith.divmod %0, %1;
        %4 = hir.assertz %2 <{ code = #builtin.u32<250>, message = "" }>;
        %5 = hir.int_to_ptr %3 <{ ty = #builtin.type<ptr<i32, element>> }>;
        %6 = hir.load %5;
        %7 = arith.constant 8 : u32;
        %8 = arith.add %0, %7 <{ overflow = #builtin.overflow<checked> }>;
        %9 = arith.constant 4 : u32;
        %10, %11 = arith.divmod %8, %9;
        %12 = hir.assertz %10 <{ code = #builtin.u32<250>, message = "" }>;
        %13 = hir.int_to_ptr %11 <{ ty = #builtin.type<ptr<i32, element>> }>;
        %14 = hir.load %13;
        %15 = arith.constant 4 : u32;
        %16 = arith.add %0, %15 <{ overflow = #builtin.overflow<checked> }>;
        %17 = arith.constant 4 : u32;
        %18, %19 = arith.divmod %16, %17;
        %20 = hir.assertz %18 <{ code = #builtin.u32<250>, message = "" }>;
        %21 = hir.int_to_ptr %19 <{ ty = #builtin.type<ptr<i32, element>> }>;
        %22 = hir.load %21;
        builtin.ret %6, %14, %22 : (i32, i32, i32);
    };

    // The range analysis proves that the base is at most 32, so even a single access applies its
    // offset without a check.
    // CHECK-LABEL: @proven_base(
    // CHECK-NOT: arith.add_overflowing
    // CHECK: %[[R:\d+]], %[[Q:\d+]] = arith.divmod %{{\d+}}, %{{\d+}};
    // CHECK-NEXT: %[[Q8:\d+]] = arith.add %[[Q]], %{{\d+}} <{ overflow = #builtin.overflow<unchecked> }>;
    // CHECK-NEXT: hir.assertz %[[R]]
    // CHECK-NEXT: hir.int_to_ptr %[[Q8]]
    builtin.function public extern("C") @proven_base(%0: i1) -> i32 {
        %1 = scf.if %0 then {
            %2 = arith.constant 16 : u32;
            scf.yield %2 : (u32);
        } else {
            %3 = arith.constant 32 : u32;
            scf.yield %3 : (u32);
        } : (i1) -> (u32);
        %4 = arith.constant 8 : u32;
        %5 = arith.add %1, %4 <{ overflow = #builtin.overflow<checked> }>;
        %6 = arith.constant 4 : u32;
        %7, %8 = arith.divmod %5, %6;
        %9 = hir.assertz %7 <{ code = #builtin.u32<250>, message = "" }>;
        %10 = hir.int_to_ptr %8 <{ ty = #builtin.type<ptr<i32, element>> }>;
        %11 = hir.load %10;
        builtin.ret %11 : (i32);
    };

    // A single unproven access keeps its checked addition: a separate check would cost more.
    // CHECK: @single_unproven(%[[B:\d+]]: u32)
    // CHECK-NOT: arith.add_overflowing
    // CHECK: %[[S:\d+]] = arith.add %[[B]], %{{\d+}} <{ overflow = #builtin.overflow<checked> }>;
    // CHECK-NEXT: arith.divmod %[[S]]
    builtin.function public extern("C") @single_unproven(%0: u32) -> i32 {
        %1 = arith.constant 8 : u32;
        %2 = arith.add %0, %1 <{ overflow = #builtin.overflow<checked> }>;
        %3 = arith.constant 4 : u32;
        %4, %5 = arith.divmod %2, %3;
        %6 = hir.assertz %4 <{ code = #builtin.u32<250>, message = "" }>;
        %7 = hir.int_to_ptr %5 <{ ty = #builtin.type<ptr<i32, element>> }>;
        %8 = hir.load %7;
        builtin.ret %8 : (i32);
    };

    // A wrapping addition may wrap around, and an offset that is not a multiple of the divisor
    // changes the remainder: neither is split off the base.
    // CHECK: @not_offsets(%[[B:\d+]]: u32)
    // CHECK-NOT: arith.add_overflowing
    // CHECK: %[[W:\d+]] = arith.add %[[B]], %{{\d+}} <{ overflow = #builtin.overflow<wrapping> }>;
    // CHECK-NEXT: arith.divmod %[[W]]
    // CHECK: %[[M:\d+]] = arith.add %[[B]], %{{\d+}} <{ overflow = #builtin.overflow<checked> }>;
    // CHECK-NEXT: arith.divmod %[[M]]
    builtin.function public extern("C") @not_offsets(%0: u32) -> (u32, u32) {
        %1 = arith.constant 4 : u32;
        %2, %3 = arith.divmod %0, %1;
        %4 = arith.constant 8 : u32;
        %5 = arith.add %0, %4 <{ overflow = #builtin.overflow<wrapping> }>;
        %6, %7 = arith.divmod %5, %1;
        %8 = arith.constant 6 : u32;
        %9 = arith.add %0, %8 <{ overflow = #builtin.overflow<checked> }>;
        %10, %11 = arith.divmod %9, %1;
        %12 = arith.add %7, %11 <{ overflow = #builtin.overflow<checked> }>;
        builtin.ret %3, %12 : (u32, u32);
    };

    // Divisions in different blocks are not shared: a check in one branch must not trap on a path
    // through the other one.
    // CHECK-LABEL: @different_blocks(
    // CHECK-NOT: arith.add_overflowing
    // CHECK: scf.if
    // CHECK: arith.add %{{\d+}}, %{{\d+}} <{ overflow = #builtin.overflow<checked> }>;
    // CHECK: } else {
    // CHECK: arith.add %{{\d+}}, %{{\d+}} <{ overflow = #builtin.overflow<checked> }>;
    builtin.function public extern("C") @different_blocks(%0: i1, %1: u32) -> u32 {
        %2 = arith.constant 4 : u32;
        %3 = scf.if %0 then {
            %4 = arith.constant 8 : u32;
            %5 = arith.add %1, %4 <{ overflow = #builtin.overflow<checked> }>;
            %6, %7 = arith.divmod %5, %2;
            scf.yield %7 : (u32);
        } else {
            %8 = arith.constant 12 : u32;
            %9 = arith.add %1, %8 <{ overflow = #builtin.overflow<checked> }>;
            %10, %11 = arith.divmod %9, %2;
            scf.yield %11 : (u32);
        } : (i1) -> (u32);
        builtin.ret %3 : (u32);
    };

    // The base of one group may be the quotient of another group's division, which the rewrite of
    // the first group replaces: the second group must use the replacement.
    // CHECK: @chained(%[[X:\d+]]: u32)
    // CHECK: %[[R0:\d+]], %[[Q0:\d+]] = arith.divmod %[[X]], %{{\d+}};
    // CHECK-NEXT: %[[B:\d+]] = arith.add %[[Q0]], %{{\d+}} <{ overflow = #builtin.overflow<unchecked> }>;
    // CHECK-NEXT: %[[OVF:\d+]], %{{\d+}} = arith.add_overflowing %[[B]], %{{\d+}};
    // CHECK-NEXT: hir.assertz %[[OVF]]
    // CHECK-NEXT: arith.divmod %[[B]], %{{\d+}};
    builtin.function public extern("C") @chained(%0: u32) -> (u32, u32) {
        %1 = arith.constant 4 : u32;
        %2 = arith.constant 8 : u32;
        %3 = arith.add %0, %2 <{ overflow = #builtin.overflow<checked> }>;
        %4, %5 = arith.divmod %3, %1;
        %6 = arith.add %0, %1 <{ overflow = #builtin.overflow<checked> }>;
        %7, %8 = arith.divmod %6, %1;
        %9 = arith.add %5, %2 <{ overflow = #builtin.overflow<checked> }>;
        %10, %11 = arith.divmod %9, %1;
        %12 = arith.add %5, %1 <{ overflow = #builtin.overflow<checked> }>;
        %13, %14 = arith.divmod %12, %1;
        builtin.ret %11, %14 : (u32, u32);
    };

    // Loads of one local read the same base until the local is stored again: the second load joins
    // the first group, while the load after the store starts a new one.
    // CHECK-LABEL: @locals(
    // CHECK: hir.store_local
    // CHECK-NEXT: %[[L:\d+]] = hir.load_local
    // CHECK-NEXT: %[[B:\d+]] = hir.bitcast %[[L]]
    // CHECK-NEXT: %[[OVF:\d+]], %{{\d+}} = arith.add_overflowing %[[B]], %{{\d+}};
    // CHECK-NEXT: hir.assertz %[[OVF]]
    // CHECK-NEXT: %{{\d+}}, %[[Q:\d+]] = arith.divmod %[[B]], %{{\d+}};
    // CHECK-NOT: hir.load_local
    // CHECK: arith.add %[[Q]], %{{\d+}} <{ overflow = #builtin.overflow<unchecked> }>;
    // CHECK-NOT: hir.load_local
    // CHECK: arith.add %[[Q]], %{{\d+}} <{ overflow = #builtin.overflow<unchecked> }>;
    // CHECK: hir.store_local
    // CHECK-NEXT: %[[L2:\d+]] = hir.load_local
    // CHECK-NEXT: %[[B2:\d+]] = hir.bitcast %[[L2]]
    // CHECK-NEXT: arith.add %[[B2]], %{{\d+}} <{ overflow = #builtin.overflow<checked> }>;
    builtin.function public extern("C") @locals(%0: i32, %1: i32) -> (i32, i32) {
        hir.store_local %0 <{ local = #builtin.local_variable<0, i32> }> : (i32);
        %2 = hir.load_local <{ local = #builtin.local_variable<0, i32> }>;
        %3 = hir.bitcast %2 <{ ty = #builtin.type<u32> }>;
        %4 = arith.constant 4 : u32;
        %5 = arith.add %3, %4 <{ overflow = #builtin.overflow<checked> }>;
        %6, %7 = arith.divmod %5, %4;
        %8 = hir.assertz %6 <{ code = #builtin.u32<250>, message = "" }>;
        %9 = hir.int_to_ptr %7 <{ ty = #builtin.type<ptr<i32, element>> }>;
        hir.store %9, %1 : (ptr<i32, element>, i32);
        %10 = hir.load_local <{ local = #builtin.local_variable<0, i32> }>;
        %11 = hir.bitcast %10 <{ ty = #builtin.type<u32> }>;
        %12 = arith.constant 8 : u32;
        %13 = arith.add %11, %12 <{ overflow = #builtin.overflow<checked> }>;
        %14, %15 = arith.divmod %13, %4;
        %16 = hir.assertz %14 <{ code = #builtin.u32<250>, message = "" }>;
        %17 = hir.int_to_ptr %15 <{ ty = #builtin.type<ptr<i32, element>> }>;
        %18 = hir.load %17;
        hir.store_local %1 <{ local = #builtin.local_variable<0, i32> }> : (i32);
        %19 = hir.load_local <{ local = #builtin.local_variable<0, i32> }>;
        %20 = hir.bitcast %19 <{ ty = #builtin.type<u32> }>;
        %21 = arith.add %20, %12 <{ overflow = #builtin.overflow<checked> }>;
        %22, %23 = arith.divmod %21, %4;
        %24 = hir.assertz %22 <{ code = #builtin.u32<250>, message = "" }>;
        %25 = hir.int_to_ptr %23 <{ ty = #builtin.type<ptr<i32, element>> }>;
        %26 = hir.load %25;
        builtin.ret %18, %26 : (i32, i32);
    };

    // A memory write may modify a local whose address is taken, so its loads are never merged.
    // CHECK-LABEL: @address_taken(
    // CHECK-NOT: arith.add_overflowing
    // CHECK: builtin.ret
    builtin.function public extern("C") @address_taken(%0: u32, %1: u32) -> (u32, u32) {
        %2 = hir.local_address <{ local = #builtin.local_variable<0, u32> }>;
        hir.store_local %0 <{ local = #builtin.local_variable<0, u32> }> : (u32);
        %3 = hir.load_local <{ local = #builtin.local_variable<0, u32> }>;
        %4 = arith.constant 4 : u32;
        %5 = arith.add %3, %4 <{ overflow = #builtin.overflow<checked> }>;
        %6, %7 = arith.divmod %5, %4;
        hir.store %2, %1 : (ptr<u32, element>, u32);
        %8 = hir.load_local <{ local = #builtin.local_variable<0, u32> }>;
        %9 = arith.constant 8 : u32;
        %10 = arith.add %8, %9 <{ overflow = #builtin.overflow<checked> }>;
        %11, %12 = arith.divmod %10, %4;
        builtin.ret %7, %12 : (u32, u32);
    };
};
