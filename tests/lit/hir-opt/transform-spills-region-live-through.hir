// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(transform-spills))' | filecheck %s
// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(transform-spills,transform-spills))' | filecheck %s

// A spill inside one arm must end the captured value's live range outside the if as well.
// The bypass arm must initialize the same slot, so the store belongs before the if, and the
// value is reloaded at its next use after it. Without this, the unused inner spill is erased
// and %1 stays on the stack across the call's sixteen felt operands. The inner spill is not
// kept either: the store before the if dominates it.
// CHECK-LABEL: @live_through
// CHECK: hir.store_local %[[LIVE:\d+]] <{ local = #builtin.local_variable<[[SLOT:\d+]], u32> }>
// CHECK-NEXT: scf.if
// CHECK: hir.exec
// CHECK-NOT: hir.store_local
// CHECK: } else {
// CHECK: } : (i1) -> ();
// CHECK-NEXT: %[[RELOADED:\d+]] = hir.load_local <{ local = #builtin.local_variable<[[SLOT]], u32> }>;
// CHECK-NEXT: builtin.ret %[[RELOADED]] : (u32);
builtin.module public @test {
    builtin.function public extern("C") @live_through(%0: i1, %1: u32) -> u32 {
        scf.if %0 then {
            %2 = arith.constant 1 : u128;
            %3 = hir.exec ::@test::@consume(%2, %2, %2, %2) : extern("C") (u128, u128, u128, u128) -> u32;
            scf.yield : ();
        } else {
            scf.yield : ();
        } : (i1) -> ();
        builtin.ret %1 : (u32);
    };
    // The same live range crosses two region boundaries. Both must be reconstructed before
    // pruning the inner stores and reloads, or an original SSA use survives outside its spill.
    // CHECK-LABEL: @nested_live_through
    // CHECK: hir.store_local %{{\d+}} <{ local = #builtin.local_variable<[[NESTED_SLOT:\d+]], u32> }>
    // CHECK-NEXT: scf.if
    // CHECK: hir.exec
    // CHECK: %[[NESTED_RELOAD:\d+]] = hir.load_local <{ local = #builtin.local_variable<[[NESTED_SLOT]], u32> }>;
    // CHECK-NEXT: builtin.ret %[[NESTED_RELOAD]] : (u32);
    builtin.function public extern("C") @nested_live_through(%0: i1, %1: u32, %2: i1) -> u32 {
        scf.if %0 then {
            scf.if %2 then {
                %3 = arith.constant 1 : u128;
                %4 = hir.exec ::@test::@consume(%3, %3, %3, %3) : extern("C") (u128, u128, u128, u128) -> u32;
                scf.yield : ();
            } else {
                scf.yield : ();
            } : (i1) -> ();
            scf.yield : ();
        } else {
            scf.yield : ();
        } : (i1) -> ();
        builtin.ret %1 : (u32);
    };
    // Captures used on later iterations must be reloaded within each loop region, even when
    // neither capture is used after the loop. A reload after the loop cannot shorten that lifetime.
    // CHECK: @loop_captures(%[[LIMIT:\d+]]: u32, %[[VALUE:\d+]]: u32)
    // CHECK: hir.store_local %[[VALUE]] <{ local = #builtin.local_variable<[[VALUE_SLOT:\d+]], u32> }>
    // CHECK: hir.store_local %[[LIMIT]] <{ local = #builtin.local_variable<[[LIMIT_SLOT:\d+]], u32> }>
    // CHECK: scf.while
    // CHECK: hir.load_local <{ local = #builtin.local_variable<[[LIMIT_SLOT]], u32> }>
    // CHECK: } after {
    // CHECK: %[[CAPTURE:\d+]] = hir.load_local <{ local = #builtin.local_variable<[[VALUE_SLOT]], u32> }>
    // CHECK: arith.add %{{\d+}}, %[[CAPTURE]]
    // CHECK: hir.exec
    // CHECK: builtin.ret
    builtin.function public extern("C") @loop_captures(%0: u32, %1: u32) -> u32 {
        %2 = arith.constant 0 : u32;
        %3 = scf.while %2 before {
        ^before(%4: u32):
            %5 = arith.lt %4, %0;
            scf.condition %5, %4 : (i1, u32);
        } after {
        ^after(%6: u32):
            %7 = arith.add %6, %1 <{ overflow = #builtin.overflow<unchecked> }>;
            %8 = arith.constant 1 : u128;
            %9 = hir.exec ::@test::@consume(%8, %8, %8, %8) : extern("C") (u128, u128, u128, u128) -> u32;
            scf.yield %7 : (u32);
        } : (u32) -> (u32);
        builtin.ret %3 : (u32);
    };
    // A value captured by several regions is stored once, before the first region that evicts
    // it, and reloaded at each later use: the condition before every if, the returned value
    // once at the end. No region stores either value again. All three boundaries must be
    // handled by a single pass.
    // CHECK-LABEL: @successive_regions
    // CHECK: hir.store_local %{{\d+}} <{ local = #builtin.local_variable<[[KEPT_SLOT:\d+]], u32> }>
    // CHECK: hir.store_local %[[COND:\d+]] <{ local = #builtin.local_variable<[[COND_SLOT:\d+]], i1> }>
    // CHECK-NEXT: scf.if %[[COND]]
    // CHECK-NOT: hir.store_local
    // CHECK: %[[COND1:\d+]] = hir.load_local <{ local = #builtin.local_variable<[[COND_SLOT]], i1> }>;
    // CHECK-NEXT: scf.if %[[COND1]]
    // CHECK-NOT: hir.store_local
    // CHECK: %[[COND2:\d+]] = hir.load_local <{ local = #builtin.local_variable<[[COND_SLOT]], i1> }>;
    // CHECK-NEXT: scf.if %[[COND2]]
    // CHECK-NOT: hir.store_local
    // CHECK: %[[FINAL_RELOAD:\d+]] = hir.load_local <{ local = #builtin.local_variable<[[KEPT_SLOT]], u32> }>;
    // CHECK-NEXT: builtin.ret %[[FINAL_RELOAD]] : (u32);
    builtin.function public extern("C") @successive_regions(%0: i1, %1: u32) -> u32 {
        scf.if %0 then {
            %2 = arith.constant 1 : u128;
            %3 = hir.exec ::@test::@consume(%2, %2, %2, %2) : extern("C") (u128, u128, u128, u128) -> u32;
            scf.yield : ();
        } else { scf.yield : (); } : (i1) -> ();
        scf.if %0 then {
            %4 = arith.constant 1 : u128;
            %5 = hir.exec ::@test::@consume(%4, %4, %4, %4) : extern("C") (u128, u128, u128, u128) -> u32;
            scf.yield : ();
        } else { scf.yield : (); } : (i1) -> ();
        scf.if %0 then {
            %6 = arith.constant 1 : u128;
            %7 = hir.exec ::@test::@consume(%6, %6, %6, %6) : extern("C") (u128, u128, u128, u128) -> u32;
            scf.yield : ();
        } else { scf.yield : (); } : (i1) -> ();
        builtin.ret %1 : (u32);
    };
    builtin.function public extern("C") @consume(%0: u128, %1: u128, %2: u128, %3: u128) -> u32 {
        %4 = arith.constant 0 : u32;
        builtin.ret %4 : (u32);
    };
};
