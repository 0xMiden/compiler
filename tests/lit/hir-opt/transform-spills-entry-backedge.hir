// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(transform-spills))' | filecheck %s

// COM: The rewritten IR is not re-parsed here, unlike in the sibling tests: the printer leaves the
// COM: entry block unlabelled even when branches target it, so its output does not parse back.
// Both arms branch back to the entry block, which therefore has two predecessors and lies in its
// own dominance frontier, although it has no immediate dominator. The frontier computation used
// to expect one and panic. The spilled value is reloaded in the arm that needs it, and no block
// argument is added to the entry: its arguments are the function's parameters, so the signature
// must stay as it is.

// CHECK: @entry_backedge() -> u32 {
// CHECK: hir.store_local %[[V:\d+]] <{ local = #builtin.local_variable<[[L:\d+]], u32> }>
// CHECK: hir.exec ::@test::@example
// CHECK: hir.load_local <{ local = #builtin.local_variable<[[L]], u32> }>
// CHECK-NOT: cf.br ^{{[a-z0-9]+}}(
builtin.module public @test {
    builtin.function public extern("C") @entry_backedge() -> u32 {
    ^entry:
        %90 = arith.constant 1 : u32;
        %0 = hir.int_to_ptr %90 <{ ty = #builtin.type<ptr<u8, element>> }>;
        %1 = hir.ptr_to_int %0 <{ ty = #builtin.type<u32> }>;
        %2 = arith.constant 32 : u32;
        %3 = arith.add %1, %2 <{ overflow = #builtin.overflow<unchecked> }>;
        %4 = hir.int_to_ptr %3 <{ ty = #builtin.type<ptr<u128, element>> }>;
        %5 = hir.load %4;
        %6 = arith.constant 64 : u32;
        %7 = arith.add %1, %6 <{ overflow = #builtin.overflow<unchecked> }>;
        %8 = hir.int_to_ptr %7 <{ ty = #builtin.type<ptr<u128, element>> }>;
        %9 = hir.load %8;
        %10 = arith.constant 0 : u32;
        %11 = arith.eq %1, %10;
        cf.cond_br %11 ^then, ^other : (i1);
    ^then:
        %12 = arith.constant 1 : u64;
        %13 = hir.exec ::@test::@example(%8, %5, %9, %9, %12) : extern("C") (ptr<u128, element>, u128, u128, u128, u64) -> u32;
        %80 = arith.add %1, %3 <{ overflow = #builtin.overflow<unchecked> }>;
        %81 = arith.add %1, %3 <{ overflow = #builtin.overflow<unchecked> }>;
        cf.br ^entry;
    ^other:
        %14 = arith.constant 2 : u64;
        %15 = hir.exec ::@test::@example(%8, %5, %9, %9, %14) : extern("C") (ptr<u128, element>, u128, u128, u128, u64) -> u32;
        cf.br ^entry;
    };
    builtin.function public extern("C") @example(%p: ptr<u128, element>, %x: u128, %y: u128, %z: u128, %w: u64) -> u32 {
        builtin.ret_imm 42 : u32;
    };
};
