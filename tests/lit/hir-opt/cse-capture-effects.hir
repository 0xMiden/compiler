// RUN: hir-opt %s --verify --pass-pipeline='builtin.module(builtin.function(cse))' | filecheck %s
// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(cse))' | filecheck %s
builtin.module public @capture_effects {
    // CHECK-LABEL: @killed
    // CHECK: scf.if
    // CHECK: di.debug_kill
    // CHECK-NOT: scf.if
    // CHECK: builtin.ret
    builtin.function public extern("C") @killed(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        builtin.ret %sum : (u32);
    };

    // CHECK-LABEL: @rebound
    // CHECK: scf.if
    // CHECK: di.debug_kill
    // CHECK-NOT: scf.if
    // CHECK: builtin.ret
    builtin.function public extern("C") @rebound(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        di.debug_value %right <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        builtin.ret %sum : (u32);
    };

    // CHECK-LABEL: @asymmetric
    // CHECK: scf.if
    // CHECK: di.debug_kill
    // CHECK-NOT: scf.if
    // CHECK: builtin.ret
    builtin.function public extern("C") @asymmetric(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "other", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        builtin.ret %sum : (u32);
    };

    // CHECK-LABEL: @unmatched
    // CHECK: scf.if
    // CHECK: di.debug_kill
    // CHECK-NOT: scf.if
    // CHECK: builtin.ret
    builtin.function public extern("C") @unmatched(%condition: i1, %left: u32, %right: u32) -> u32 {
        %first = scf.if %condition then {
            
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        
        %second = scf.if %condition then {
            di.debug_value %left <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
            scf.yield %left : (u32);
        } else {
            di.debug_kill <{ variable = #di.variable<{ name = "branch", file = "test.rs", line = 1 }> }>;
            scf.yield %right : (u32);
        } : (i1) -> u32;
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        builtin.ret %sum : (u32);
    };

};
