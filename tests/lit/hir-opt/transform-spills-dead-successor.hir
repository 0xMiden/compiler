// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(transform-spills))' | filecheck %s

// The `cf.switch` selector is a constant, so the dead-code analysis proves `^then` unreachable and
// records no predecessor for it. The spills analysis visits only the blocks control can reach: the
// `^else` arm spills the value live across its high-pressure call, the join reloads it, and the
// dead `^then` arm is left as it is.
//
// Operand stack pressure at the call (the analysis models pressure in felts with K = 16): the call
// arguments require 15 felts (%8: ptr = 1, %5: u128 = 4, %9: u128 passed twice = 8, u64 = 2),
// and %1: u32 and %3: u32 are live across the call (used only in the join block), for a total of
// 15 + 2 = 17 > K, so one of them is spilled before the call.

// COM: Nothing is spilled before the switch
// CHECK-NOT: hir.store_local
// CHECK: cf.switch %{{\d+}} [#builtin.u32<0> -> ^[[THEN:block\d+]]], ^[[ELSE:block\d+]]

// COM: The dead arm neither spills nor reloads
// CHECK: ^[[THEN]]:
// CHECK-NOT: hir.store_local
// CHECK-NOT: hir.load_local
// CHECK: hir.exec ::@test::@example
// CHECK-NEXT: cf.br ^[[JOIN:block\d+]](

// COM: The live arm spills before its call
// CHECK: ^[[ELSE]]:
// CHECK: hir.store_local %{{\d+}} <{ local = #builtin.local_variable<[[L:\d+]], u32> }>
// CHECK-NEXT: hir.exec ::@test::@example
// CHECK-NEXT: cf.br ^[[JOIN]](

// COM: The join reloads the spilled value
// CHECK: ^[[JOIN]](
// CHECK-NOT: hir.store_local
// CHECK: hir.load_local <{ local = #builtin.local_variable<[[L]], u32> }>
// CHECK: builtin.ret %
builtin.module public @test {
    builtin.function public extern("C") @dead_successor(%0: ptr<u8, element>) -> u32 {
        %1 = hir.ptr_to_int %0 <{ ty = #builtin.type<u32> }>;
        %2 = arith.constant 32 : u32;
        %3 = arith.add %1, %2 <{ overflow = #builtin.overflow<unchecked> }>;
        %4 = hir.int_to_ptr %3 <{ ty = #builtin.type<ptr<u128, element>> }>;
        %5 = hir.load %4;
        %6 = arith.constant 64 : u32;
        %7 = arith.add %1, %6 <{ overflow = #builtin.overflow<unchecked> }>;
        %8 = hir.int_to_ptr %7 <{ ty = #builtin.type<ptr<u128, element>> }>;
        %9 = hir.load %8;
        %10 = arith.constant 1 : u32;
        cf.switch %10 [#builtin.u32<0> -> ^then], ^else : (u32);
    ^then:
        %12 = arith.constant 1 : u64;
        %13 = hir.exec ::@test::@example(%8, %5, %9, %9, %12) : extern("C") (ptr<u128, element>, u128, u128, u128, u64) -> u32;
        cf.br ^join(%13 : u32);
    ^else:
        %14 = arith.constant 1 : u64;
        %15 = hir.exec ::@test::@example(%8, %5, %9, %9, %14) : extern("C") (ptr<u128, element>, u128, u128, u128, u64) -> u32;
        cf.br ^join(%15 : u32);
    ^join(%16: u32):
        %17 = arith.constant 5 : u32;
        %18 = arith.add %1, %17 <{ overflow = #builtin.overflow<unchecked> }>;
        %19 = arith.add %18, %16 <{ overflow = #builtin.overflow<unchecked> }>;
        %20 = arith.add %19, %3 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %20 : (u32);
    };
    builtin.function public extern("C") @example(%p: ptr<u128, element>, %x: u128, %y: u128, %z: u128, %w: u64) -> u32 {
        builtin.ret_imm 42 : u32;
    };
};
