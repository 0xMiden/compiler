// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(transform-spills))' | filecheck %s
// RUN: hir-opt %s --pass-pipeline='builtin.module(builtin.function(transform-spills))' | hir-opt --verify - | filecheck %s

// A join with two predecessors, one of them unreachable from the entry. Unreachable blocks have
// no node in the dominator tree, so the dominance frontier computation the spills transform uses
// to place its block arguments must not count them as predecessors (it used to look their tree
// node up and panic). The verifier accepts such a block, and `hir-opt` pipelines can hand it to
// the transform directly. The reachable arm spills the value live across its high-pressure call
// (15 felts of call arguments plus two live `u32`s exceed the 16-felt operand stack), and the
// value is reloaded for its use after the join.

// CHECK: cf.br ^[[THEN:block\d+]]
// CHECK: ^[[THEN]]:
// CHECK: hir.store_local %[[V:\d+]] <{ local = #builtin.local_variable<[[L:\d+]], u32> }>
// CHECK: hir.exec ::@test::@example
// CHECK: hir.load_local <{ local = #builtin.local_variable<[[L]], u32> }>
// CHECK: builtin.ret %
builtin.module public @test {
    builtin.function public extern("C") @unreachable_predecessor(%0: ptr<u8, element>) -> u32 {
        %1 = hir.ptr_to_int %0 <{ ty = #builtin.type<u32> }>;
        %2 = arith.constant 32 : u32;
        %3 = arith.add %1, %2 <{ overflow = #builtin.overflow<unchecked> }>;
        %4 = hir.int_to_ptr %3 <{ ty = #builtin.type<ptr<u128, element>> }>;
        %5 = hir.load %4;
        %6 = arith.constant 64 : u32;
        %7 = arith.add %1, %6 <{ overflow = #builtin.overflow<unchecked> }>;
        %8 = hir.int_to_ptr %7 <{ ty = #builtin.type<ptr<u128, element>> }>;
        %9 = hir.load %8;
        cf.br ^then;
    ^then:
        %12 = arith.constant 1 : u64;
        %13 = hir.exec ::@test::@example(%8, %5, %9, %9, %12) : extern("C") (ptr<u128, element>, u128, u128, u128, u64) -> u32;
        cf.br ^join(%13 : u32);
    ^else:
        %14 = arith.constant 1 : u64;
        %15 = hir.exec ::@test::@example(%8, %5, %9, %9, %14) : extern("C") (ptr<u128, element>, u128, u128, u128, u64) -> u32;
        cf.br ^join(%15 : u32);
    ^join(%16: u32):
        %17 = arith.constant 5 : u32;
        %18 = arith.add %1, %17 <{ overflow = #builtin.overflow<unchecked> }>;
        %19 = arith.add %18, %16 <{ overflow = #builtin.overflow<unchecked> }>;
        %20 = arith.add %19, %3 <{ overflow = #builtin.overflow<unchecked> }>;
        builtin.ret %20 : (u32);
    };
    builtin.function public extern("C") @example(%p: ptr<u128, element>, %x: u128, %y: u128, %z: u128, %w: u64) -> u32 {
        builtin.ret_imm 42 : u32;
    };
};
