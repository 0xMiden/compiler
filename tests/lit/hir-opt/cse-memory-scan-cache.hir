// RUN: hir-opt %s --verify --pass-pipeline='builtin.module(builtin.function(cse))' | filecheck %s
builtin.module public @cache {
    // CHECK-LABEL: @three_reads
    // CHECK: hir.store_local
    // CHECK: %[[FIRST:\d+]] = hir.load_local
    // CHECK-NOT: hir.load_local
    // CHECK: di.debug_value %[[FIRST]]
    // CHECK: hir.store_local
    // CHECK: %[[THIRD:\d+]] = hir.load_local
    // CHECK: di.debug_value %[[THIRD]]
    // CHECK: %[[SUM:\d+]] = arith.add %[[FIRST]], %[[FIRST]]
    // CHECK: arith.add %[[SUM]], %[[THIRD]]
    builtin.function public extern("C") @three_reads(%before: u32, %after: u32) -> u32 {
        hir.store_local %before <{ local = #builtin.local_variable<0, u32> }> : (u32);
        %first = hir.load_local <{ local = #builtin.local_variable<0, u32> }>;
        %second = hir.load_local <{ local = #builtin.local_variable<0, u32> }>;
        di.debug_value %second <{ variable = #di.variable<{ name = "second", file = "test.rs", line = 1 }>, expression = #di.expression<[]> }> : (u32);
        hir.store_local %after <{ local = #builtin.local_variable<0, u32> }> : (u32);
        %third = hir.load_local <{ local = #builtin.local_variable<0, u32> }>;
        di.debug_value %third <{ variable = #di.variable<{ name = "third", file = "test.rs", line = 2 }>, expression = #di.expression<[]> }> : (u32);
        %sum = arith.add %first, %second <{ overflow = #builtin.overflow<wrapping> }>;
        %result = arith.add %sum, %third <{ overflow = #builtin.overflow<wrapping> }>;
        builtin.ret %result : (u32);
    };
};
