// RUN: not hir-opt --verify %s 2>&1 | filecheck %s

// The before block of `scf.while` must end in `scf.condition`.
builtin.function public extern("C") @f(%n: u32) -> u32 {
    scf.while %n before {
    ^head(%i: u32):
        ub.unreachable;
    } after {
    ^body:
        scf.yield %n : (u32);
    } : (u32) -> ();
    builtin.ret %n : (u32);
};

// CHECK: invalid operation scf.while
// CHECK: must end in scf.condition
