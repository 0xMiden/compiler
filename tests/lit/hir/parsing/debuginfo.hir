// RUN: hir-opt %s | filecheck %s

// Round-trip parse/print coverage for the debuginfo (di) dialect attributes:
// variable attrs with column/arg/ty properties, and expression attrs covering
// target-neutral local/global frame bases (with positive and negative offsets),
// local slots, and multi-op expressions.
// The body below is the canonical printer output, so the reprint must match it exactly.
builtin.function public extern("C") @debuginfo(%0: i32, %1: i32) -> i32 {
    di.debug_declare <{ variable = #di.variable<{ name = "a", file = "test.rs", line = 19, column = 7, arg = 0, ty = i32 }>, expression = #di.expression<[DI_OP_frame_base(local_slot, 2+8)]> }>;
    di.debug_declare <{ variable = #di.variable<{ name = "b", file = "test.rs", line = 20, arg = 1 }>, expression = #di.expression<[DI_OP_frame_base(global_slot, "__stack_pointer"-16)]> }>;
    di.debug_declare <{ variable = #di.variable<{ name = "s", file = "test.rs", line = 21 }>, expression = #di.expression<[DI_OP_local_slot(3), DW_OP_deref]> }>;
    di.debug_declare <{ variable = #di.variable<{ name = "g", file = "test.rs", line = 21 }>, expression = #di.expression<[DI_OP_global_slot("global4")]> }>;
    di.debug_declare <{ variable = #di.variable<{ name = "o", file = "test.rs", line = 21 }>, expression = #di.expression<[DI_OP_operand_stack_slot(1)]> }>;
    %2 = arith.add %0, %1 <{ overflow = #builtin.overflow<wrapping> }>;
    di.debug_value %2 <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 22, ty = i32 }>, expression = #di.expression<[]> }> : (i32);
    di.debug_value %2 <{ variable = #di.variable<{ name = "y", file = "test.rs", line = 23 }>, expression = #di.expression<[DW_OP_constu(4), DW_OP_plus, DW_OP_stack_value]> }> : (i32);
    di.debug_kill <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 22, ty = i32 }> }>;
    builtin.ret %2 : (i32);
} attributes { di.subprogram = #di.subprogram<{ name = "fib", file = "test.rs", line = 3, column = 5, linkage = "_ZN3fib", params = ["a", "b"], definition = true, local = true }> };

// CHECK: builtin.function public extern("C") @debuginfo(%0: i32, %1: i32) -> i32 {
// CHECK-NEXT:     di.debug_declare <{ variable = #di.variable<{ name = "a", file = "test.rs", line = 19, column = 7, arg = 0, ty = i32 }>, expression = #di.expression<[DI_OP_frame_base(local_slot, 2+8)]> }>;
// CHECK-NEXT:     di.debug_declare <{ variable = #di.variable<{ name = "b", file = "test.rs", line = 20, arg = 1 }>, expression = #di.expression<[DI_OP_frame_base(global_slot, "__stack_pointer"-16)]> }>;
// CHECK-NEXT:     di.debug_declare <{ variable = #di.variable<{ name = "s", file = "test.rs", line = 21 }>, expression = #di.expression<[DI_OP_local_slot(3), DW_OP_deref]> }>;
// CHECK-NEXT:     di.debug_declare <{ variable = #di.variable<{ name = "g", file = "test.rs", line = 21 }>, expression = #di.expression<[DI_OP_global_slot("global4")]> }>;
// CHECK-NEXT:     di.debug_declare <{ variable = #di.variable<{ name = "o", file = "test.rs", line = 21 }>, expression = #di.expression<[DI_OP_operand_stack_slot(1)]> }>;
// CHECK-NEXT:     %2 = arith.add %0, %1 <{ overflow = #builtin.overflow<wrapping> }>;
// CHECK-NEXT:     di.debug_value %2 <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 22, ty = i32 }>, expression = #di.expression<[]> }> : (i32);
// CHECK-NEXT:     di.debug_value %2 <{ variable = #di.variable<{ name = "y", file = "test.rs", line = 23 }>, expression = #di.expression<[DW_OP_constu(4), DW_OP_plus, DW_OP_stack_value]> }> : (i32);
// CHECK-NEXT:     di.debug_kill <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 22, ty = i32 }> }>;
// CHECK-NEXT:     builtin.ret %2 : (i32);
// CHECK-NEXT: } attributes { di.subprogram = #di.subprogram<{ name = "fib", file = "test.rs", line = 3, column = 5, linkage = "_ZN3fib", params = ["a", "b"], definition = true, local = true }> };
