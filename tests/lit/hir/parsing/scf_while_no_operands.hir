// RUN: hir-opt %s | filecheck %s

// Round-trip parse/print coverage for an `scf.while` without iteration arguments: the loop has no
// operands (the printer omits the empty operand list), its before block has no arguments (and so
// no block header), and the after block ends in an `scf.yield` with no operands.
// The body below is the canonical printer output, so the reprint must match it exactly.
builtin.function public extern("C") @no_operands(%0: u32, %1: u32) -> u32 {
    %2 = arith.constant 10 : u32;
    %7, %8 = scf.while before {
        %3 = arith.add %0, %1 <{ overflow = #builtin.overflow<unchecked> }>;
        %4 = arith.lt %3, %2;
        scf.condition %4, %0, %3 : (i1, u32, u32);
    } after {
    ^block3(%5: u32, %6: u32):
        scf.yield : ();
    } : () -> (u32, u32);
    %9 = arith.add %7, %8 <{ overflow = #builtin.overflow<unchecked> }>;
    builtin.ret %9 : (u32);
};

// CHECK: builtin.function public extern("C") @no_operands(%0: u32, %1: u32) -> u32 {
// CHECK-NEXT:     %2 = arith.constant 10 : u32;
// CHECK-NEXT:     %7, %8 = scf.while before {
// CHECK-NEXT:         %3 = arith.add %0, %1 <{ overflow = #builtin.overflow<unchecked> }>;
// CHECK-NEXT:         %4 = arith.lt %3, %2;
// CHECK-NEXT:         scf.condition %4, %0, %3 : (i1, u32, u32);
// CHECK-NEXT:     } after {
// CHECK-NEXT:     ^block3(%5: u32, %6: u32):
// CHECK-NEXT:         scf.yield : ();
// CHECK-NEXT:     } : () -> (u32, u32);
// CHECK-NEXT:     %9 = arith.add %7, %8 <{ overflow = #builtin.overflow<unchecked> }>;
// CHECK-NEXT:     builtin.ret %9 : (u32);
// CHECK-NEXT: };
