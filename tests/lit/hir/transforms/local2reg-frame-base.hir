// CHECK-LABEL: @indirect_value(
// CHECK: di.debug_value
// CHECK-NOT: di.debug_kill
builtin.function public extern("C") @indirect_value(%0: u32) -> u32 {
 %1 = arith.constant 16 : u32;
 %2 = hir.int_to_ptr %1 <{ ty = #builtin.type<ptr<u32, byte>> }>;
 %3 = arith.constant 7 : u32;
