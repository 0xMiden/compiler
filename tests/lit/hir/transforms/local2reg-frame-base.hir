 di.debug_declare <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 1, ty = u32 }>, expression = #di.expression<[DI_OP_frame_base(local_slot, 0+0), DW_OP_deref, DW_OP_stack_value]> }>;
 %6 = hir.load_local <{ local = #builtin.local_variable<0, u32> }>;
 hir.store %2, %3 attributes { test.debug_checkpoint = #builtin.u32<1> } : (ptr<u32, byte>, u32);
 %7 = arith.constant 99 : u32;
