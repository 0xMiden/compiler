};

// CHECK-LABEL: @wide(
// CHECK: di.debug_value
// CHECK-NOT: di.debug_kill
builtin.function public extern("C") @wide(%0: u32, %1: u64) -> u32 {
 %2 = hir.int_to_ptr %0 <{ ty = #builtin.type<ptr<u64, byte>> }>;
 hir.store %2, %1 : (ptr<u64, byte>, u64);
 hir.store_local %0 <{ local = #builtin.local_variable<0, u32> }> : (u32);
 di.debug_declare <{ variable = #di.variable<{ name = "wide", file = "test.rs", line = 1, ty = u64 }>, expression = #di.expression<[DI_OP_frame_base(local_slot, 0+0)]> }>;
 %3 = hir.load_local <{ local = #builtin.local_variable<0, u32> }>;
 builtin.ret %3 : (u32);
};
};
