builtin.module public @storage_if {
  builtin.function public extern("C") @probe(%condition: i1) -> u32 {
    %raw = hir.advice_pop;
    %address = arith.constant 64 : u32;
    %pointer = hir.int_to_ptr %address <{ ty = #builtin.type<ptr<felt, element>> }>;
    hir.store %pointer, %raw : (ptr<felt, element>, felt);
    %result = scf.if %condition then {
      %loaded = hir.load %pointer;
      %value = builtin.unrealized_conversion_cast %loaded <{ ty = #builtin.type<u32> }>;
      %one = arith.constant 1 : u32;
      %sum = arith.add %value, %one <{ overflow = #builtin.overflow<wrapping> }>;
      scf.yield %sum : (u32);
    } else {
      %zero = arith.constant 0 : u32;
      scf.yield %zero : (u32);
    } : (i1) -> u32;
    builtin.ret %result : (u32);
  };
};
