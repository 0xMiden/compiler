package miden:storage-example@1.0.0;

use miden:base/core-types@1.0.0;

interface foo {
    use core-types.{asset-amount, word, asset};

    /// Limits that apply to the account's holdings.
    record limits {
        max-qty: asset-amount,
        paused: bool,
    }

    /// The account's holding of one asset.
    record holding {
        qty: asset-amount,
        locked: bool,
    }

    @external-id("miden::storage_example::foo::set_asset_qty")
    set-asset-qty: func(pub-key: word, asset: asset, qty: asset-amount);
    @external-id("miden::storage_example::foo::get_asset_qty")
    get-asset-qty: func(asset: asset) -> asset-amount;
    @external-id("miden::storage_example::foo::get_limits")
    get-limits: func() -> limits;
    @external-id("miden::storage_example::foo::set_limits")
    set-limits: func(pub-key: word, limits: limits);
    @external-id("miden::storage_example::foo::set_holding")
    set-holding: func(pub-key: word, asset: asset, holding: holding);
    @external-id("miden::storage_example::foo::get_holding")
    get-holding: func(asset: asset) -> holding;
}

world foo-world {
    export foo;
}
