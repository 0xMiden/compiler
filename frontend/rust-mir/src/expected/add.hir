builtin.function public extern("C") @add(%0: u32, %1: u32) -> u32 {
    hir.store_local %0 <{ local = #builtin.local_variable<1, u32> }> : (u32);
    hir.store_local %1 <{ local = #builtin.local_variable<2, u32> }> : (u32);
    %2 = hir.load_local <{ local = #builtin.local_variable<1, u32> }>;
    hir.store_local %2 <{ local = #builtin.local_variable<3, u32> }> : (u32);
    %3 = hir.load_local <{ local = #builtin.local_variable<2, u32> }>;
    hir.store_local %3 <{ local = #builtin.local_variable<4, u32> }> : (u32);
    %4 = hir.load_local <{ local = #builtin.local_variable<3, u32> }>;
    %5 = hir.load_local <{ local = #builtin.local_variable<4, u32> }>;
    %6 = arith.add %4, %5 <{ overflow = #builtin.overflow<wrapping> }>;
    hir.store_local %6 <{ local = #builtin.local_variable<0, u32> }> : (u32);
    %7 = hir.load_local <{ local = #builtin.local_variable<0, u32> }>;
    builtin.ret %7 : (u32);
};
