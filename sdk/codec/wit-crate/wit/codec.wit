// Mirror note: the wit-crate file is canonical; sdk/schema/wit/codec.wit exists because
// Wasmtime bindgen!(path:) needs package-local WIT, and an equality test guards both files.
package miden:codec@1.0.0;

/// Parses, displays, and validates custom schema types.
interface codec {
    /// A canonical Miden field element at the component boundary.
    ///
    /// This is a `u64`, not the core-types `felt` record, because that record models the
    /// compiler's guest felt value and does not expose its canonical integer representation.
    type felt = u64;

    /// Returns the fully-qualified WIT names handled by this component.
    supported-types: func() -> list<string>;

    /// Parses text into a type's structural felt representation.
    parse: func(type-fqn: string, value: string) -> result<list<felt>, string>;

    /// Displays a type's structural felt representation.
    display: func(type-fqn: string, value: list<felt>) -> result<string, string>;

    /// Validates a type's structural felt representation.
    validate: func(type-fqn: string, value: list<felt>) -> result<_, string>;
}

// A WIT package cannot name an interface and a world alike, so the world is `codec-component`.
world codec-component {
    export codec;
}
